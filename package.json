{
  "name": "eslint-plugin-github-action",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Rules for consistent, readable, and valid GitHub Actions workflow files.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "github-action",
    "jobs",
    "workflow"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github-action.ntnyq.dev",
  "repository": {
    "url": "git+https://github.com/ntnyq/eslint-plugin-github-action.git"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-github-action/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "coverage": "pnpm build && vitest --coverage",
    "deploy": "run-s build docs:build",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint test typecheck",
    "release:version": "bumpp",
    "test": "pnpm build && vitest",
    "test:integration": "pnpm build && vitest --project integration",
    "test:source": "vitest --project source",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.5.0 || ^10.0.0"
  },
  "dependencies": {
    "@ntnyq/utils": "^0.26.0",
    "uncase": "^0.3.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.30",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-github-action": "workspace:*",
    "eslint-vitest-rule-tester": "^3.2.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,svg,md,yml,yaml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
